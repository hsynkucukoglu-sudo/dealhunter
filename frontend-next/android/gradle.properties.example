# Copy the block below into ~/.gradle/gradle.properties (machine-local, never
# committed) and fill in your own values. build.gradle reads these via
# project.hasProperty, so release signing works without touching any code.
#
# RELEASE_STORE_FILE=C:\\path\\to\\your-release-key.jks
# RELEASE_STORE_PASSWORD=your-store-password
# RELEASE_KEY_ALIAS=your-key-alias
# RELEASE_KEY_PASSWORD=your-key-password
